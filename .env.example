# cp .env.example .env  후 값 수정 (.env 는 git에 올라가지 않음)

# 호스트에 여는 포트
MQTT_PORT=1883
MQTT_WS_PORT=9001
WEB_PORT=8080

# 브라우저가 접속할 브로커 주소
#   같은 노트북에서 열 때: ws://localhost:9001
#   다른 기기(폰 등)에서 열 때: ws://<노트북 IP>:9001
MQTT_WS_URL=ws://localhost:9001

# 웹 페이지 기본값
DEFAULT_DEVICE_ID=xiao-01
DEFAULT_VIDEO_ID=

# sim (가짜 ESP32)
SIM_DEVICE_ID=sim-01
SIM_SCENARIO=cycle
